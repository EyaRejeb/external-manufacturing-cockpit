          <Properties>
            <Configuration>
              <FormulaFields>
                <FormulaField expression="IIF(IsEmpty([date_commande]), Null(),&#10;  IIF(Trim([format_date]) = &quot;serie_excel&quot;,&#10;      DateTimeAdd(&quot;1900-01-01&quot;, ToNumber([date_commande]) - 2, &quot;days&quot;),&#10;      DateTimeParse([date_commande],&#10;                    IIF(Trim([format_date]) = &quot;dd/MM/yyyy&quot;, &quot;%d/%m/%Y&quot;, &quot;%Y-%m-%d&quot;))))" field="dt_commande" size="10" type="Date" enabled="true" />
                <FormulaField expression="IIF(IsEmpty([date_promise]), Null(),&#10;  IIF(Trim([format_date]) = &quot;serie_excel&quot;,&#10;      DateTimeAdd(&quot;1900-01-01&quot;, ToNumber([date_promise]) - 2, &quot;days&quot;),&#10;      DateTimeParse([date_promise],&#10;                    IIF(Trim([format_date]) = &quot;dd/MM/yyyy&quot;, &quot;%d/%m/%Y&quot;, &quot;%Y-%m-%d&quot;))))" field="dt_promise" size="10" type="Date" enabled="true" />
                <FormulaField expression="IIF(IsEmpty([date_livraison]), Null(),&#10;  IIF(Trim([format_date]) = &quot;serie_excel&quot;,&#10;      DateTimeAdd(&quot;1900-01-01&quot;, ToNumber([date_livraison]) - 2, &quot;days&quot;),&#10;      DateTimeParse([date_livraison],&#10;                    IIF(Trim([format_date]) = &quot;dd/MM/yyyy&quot;, &quot;%d/%m/%Y&quot;, &quot;%Y-%m-%d&quot;))))" field="dt_livraison" size="10" type="Date" enabled="true" />
                <FormulaField expression="IIF(IsEmpty([qte_commandee]), Null(), ToNumber(Replace([qte_commandee], &quot;,&quot;, &quot;.&quot;)))" field="q_commandee" size="8" type="Double" enabled="true" />
                <FormulaField expression="IIF(IsEmpty([qte_livree]), Null(), ToNumber(Replace([qte_livree], &quot;,&quot;, &quot;.&quot;)))" field="q_livree" size="8" type="Double" enabled="true" />
                <FormulaField expression="IIF(IsEmpty([qte_conforme]), Null(), ToNumber(Replace([qte_conforme], &quot;,&quot;, &quot;.&quot;)))" field="q_conforme" size="8" type="Double" enabled="true" />
                <FormulaField expression="IIF(IsEmpty([prix_unitaire_eur]), Null(),&#10;    IIF([separateur_decimal] = &quot;,&quot;,&#10;        ToNumber(Replace([prix_unitaire_eur], &quot;,&quot;, &quot;.&quot;)),&#10;        ToNumber([prix_unitaire_eur])))" field="prix" size="8" type="Double" enabled="true" />
              </FormulaFields>
            </Configuration>
