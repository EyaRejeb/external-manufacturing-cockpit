        <Node ToolID="11">
          <GuiSettings Plugin="AlteryxBasePluginsGui.Formula.Formula">
            <Position x="170" y="470"/>
          </GuiSettings>
          <Properties>
            <Configuration>
              <FormulaFields>
                <FormulaField expression="IIF(IsEmpty([date_ouverture]), Null(), DateTimeParse([date_ouverture], &quot;%Y-%m-%d&quot;))" field="dt_ouverture" size="10" type="Date" enabled="true"/>
                <FormulaField expression="IIF(IsEmpty([date_cloture]), Null(), DateTimeParse([date_cloture], &quot;%Y-%m-%d&quot;))" field="dt_cloture" size="10" type="Date" enabled="true"/>
                <FormulaField expression="IIF(IsNull([dt_cloture]), Null(), DateTimeDiff([dt_cloture], [dt_ouverture], &quot;days&quot;))" field="delai_cloture_jours" size="4" type="Int32" enabled="true"/>
                <FormulaField expression="IIF(IsNull([dt_cloture]), DateTimeDiff(DateTimeParse(&quot;2025-12-31&quot;, &quot;%Y-%m-%d&quot;), [dt_ouverture], &quot;days&quot;), Null())" field="age_ouverte_jours" size="4" type="Int32" enabled="true"/>
                <FormulaField expression="IIF(IsNull([delai_cloture_jours]), Null(), IIF([delai_cloture_jours] &lt;= 30, &quot;oui&quot;, &quot;non&quot;))" field="cloture_30j" size="3" type="V_WString" enabled="true"/>
              </FormulaFields>
            </Configuration>
            <Annotation DisplayMode="0">
              <Name/>
              <DefaultAnnotationText>dates et délais de clôture</DefaultAnnotationText>
              <Left value="False"/>
            </Annotation>
          </Properties>
          <EngineSettings EngineDll="AlteryxBasePluginsEngine.dll" EngineDllEntryPoint="AlteryxFormula"/>
