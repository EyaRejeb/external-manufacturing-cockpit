        <Node ToolID="2">
          <GuiSettings Plugin="AlteryxBasePluginsGui.Formula.Formula">
            <Position x="170" y="120"/>
          </GuiSettings>
          <Properties>
            <Configuration>
              <FormulaFields>
                <FormulaField expression="IIF(IsEmpty([date_fabrication]), Null(), DateTimeParse([date_fabrication], &quot;%Y-%m-%d&quot;))" field="dt_fabrication" size="10" type="Date" enabled="true"/>
                <FormulaField expression="ToNumber([taille_lot])" field="n_taille_lot" size="4" type="Int32" enabled="true"/>
                <FormulaField expression="IIF(IsEmpty([cout_non_qualite_eur]), 0, ToNumber([cout_non_qualite_eur]))" field="n_cout" size="8" type="Double" enabled="true"/>
              </FormulaFields>
            </Configuration>
            <Annotation DisplayMode="0">
              <Name/>
              <DefaultAnnotationText>conversion des types</DefaultAnnotationText>
              <Left value="False"/>
            </Annotation>
          </Properties>
          <EngineSettings EngineDll="AlteryxBasePluginsEngine.dll" EngineDllEntryPoint="AlteryxFormula"/>
        </Node>
