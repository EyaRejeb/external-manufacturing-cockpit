  <Nodes>
    <Node ToolID="30">
      <GuiSettings Plugin="AlteryxGuiToolkit.TextBox.TextBox">
        <Position x="40" y="10" width="1110" height="50"/>
      </GuiSettings>
      <Properties>
        <Configuration>
          <Text>Workflow 03 : prépare les lots et les déviations du système qualité. Convertit les types, rattache chaque lot à sa commande (façonnier, SKU), calcule les délais de clôture des déviations et contrôle la cohérence. Sorties : fact_lot.csv et fact_deviation.csv.</Text>
          <Font name="Arial" size="8.25" style="0"/>
          <TextColor name="Black"/>
          <FillColor name="White"/>
          <Shape shape="0"/>
          <Justification Justification="4"/>
        </Configuration>
        <Annotation DisplayMode="0">
          <Name/>
          <DefaultAnnotationText/>
          <Left value="False"/>
        </Annotation>
      </Properties>
    </Node>
